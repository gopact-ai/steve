#!/bin/bash
# nodectl runs the node process the way the operator script on a real
# machine does, so a scenario that stops or restarts a node exercises the
# same thing here: the process goes away, the machine and its work do not.
set -u

home="${HOME:-/home/steve}"
bin="$home/steve-bin/steve-node"
config="$home/node.json"
log="$home/steve-node.log"
pidfile="$home/steve-node.pid"

running() {
	[ -f "$pidfile" ] || return 1
	local pid
	pid=$(cat "$pidfile" 2>/dev/null) || return 1
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	printf '%s' "$pid"
}

case "${1:-}" in
start)
	if pid=$(running); then
		echo "up pid=$pid"
		exit 0
	fi
	if [ ! -x "$bin" ]; then
		echo "nodectl: $bin is not there yet" >&2
		exit 1
	fi
	# The log is appended to, not replaced: a scenario that restarts a
	# node still reads what happened before the restart.
	nohup "$bin" -config "$config" >>"$log" 2>&1 &
	echo $! >"$pidfile"
	sleep 0.2
	if pid=$(running); then
		echo "up pid=$pid"
		exit 0
	fi
	echo "nodectl: the node did not stay up; tail of $log:" >&2
	tail -n 20 "$log" >&2
	exit 1
	;;
stop)
	if ! pid=$(running); then
		rm -f "$pidfile"
		echo "stopped"
		exit 0
	fi
	kill "$pid" 2>/dev/null
	for _ in $(seq 1 100); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.1
	done
	# A node that will not leave on its own is still expected to be gone
	# when this returns, so the scenario sees a machine with no node.
	kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
	rm -f "$pidfile"
	echo "stopped"
	;;
status)
	if pid=$(running); then
		echo "up pid=$pid"
	else
		echo "down"
	fi
	;;
*)
	echo "usage: nodectl start|stop|status" >&2
	exit 2
	;;
esac
