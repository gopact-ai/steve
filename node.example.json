{
  "name": "host-3",
  "listen": "0.0.0.0:7701",
  "token": "replace-me-with-a-long-random-secret",
  "workspace_root": "/home/me/steve-work",
  "state_dir": "/home/me/.steve-node",
  "capabilities": [
    "build",
    "internal-net"
  ],
  "harnesses": {
    "codex": {
      "adapter": "codex-acp",
      "models": [
        "<model-id-from-this-harness>"
      ],
      "env": [
        "PATH=/home/me/.local/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin"
      ],
      "slots": 4,
      "process_dir": "/home/me/steve-runtime"
    },
    "claude-code": {
      "command": "/home/me/.local/bin/claude-agent-acp",
      "args": [],
      "models": [
        "<model-id-from-this-harness>"
      ]
    }
  },
  "tools": [
    "docker",
    "gh"
  ],
  "mcp_servers": {},
  "declares": [
    "network:internal",
    "credential:prod"
  ],
  "hubs": {
    "hub-a": "replace-me-with-a-long-random-secret"
  },
  "mcp_broker": {
    "socket": "/home/me/.steve-mcp/mcp.sock",
    "token": "replace-me-with-a-separate-broker-token"
  }
}
