{
  "agents": {
    "codex": {
      "aliases": ["codex"],
      "harness": "codex",
      "workspace": "~/steve-workspace/codex",
      "skills": [],
      "mcp_servers": [],
      "default": true
    },
    "claude": {
      "aliases": ["claude"],
      "harness": "claude-code",
      "workspace": "~/steve-workspace/claude",
      "skills": [],
      "mcp_servers": []
