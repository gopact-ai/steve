{
  "projects": {
    "steve": {
      "home": { "path": "~/dev/steve" },
      "level": "internal",
      "repo": "inplace"
    },
    "lab": {
      "home": { "node": "host-3", "path": "/srv/steve-work/lab" },
      "level": "restricted"
    }
  },
  "agents": {
    "codex": {
      "aliases": ["codex"],
      "harness": "codex",
      "skills": [],
      "mcp_servers": [],
      "default": true
    },
    "claude": {
      "aliases": ["claude"],
      "harness": "claude-code",
      "skills": [],
      "mcp_servers": []
    },
    "builder": {
      "aliases": ["builder"],
      "harness": "codex",
      "node": "host-3",
      "requires": ["gpu"],
      "skills": [],
      "mcp_servers": []
    },
    "grok": {
      "aliases": ["grok", "grok-build"],
      "harness": "grok",
      "skills": [],
      "mcp_servers": []
    },
    "kimi": {
      "aliases": ["kimi", "kimi-code"],
      "harness": "kimi",
      "skills": [],
      "mcp_servers": []
    }
  },
  "harnesses": {
    "codex": {
      "command": "npx",
      "args": ["-y", "@agentclientprotocol/codex-acp"],
      "permission": "read",
      "slots": 4
    },
    "claude-code": {
      "command": "npx",
      "args": ["-y", "@agentclientprotocol/claude-agent-acp"],
      "permission": "read"
    },
    "grok": {
      "command": "grok",
      "args": ["agent", "--no-leader", "stdio"],
      "permission": "read"
    },
    "kimi": {
      "command": "kimi",
      "args": ["acp"],
      "permission": "read"
    }
  },
  "mcp_servers": {},
  "feishu": {
    "app_id": "cli_xxxxxxxxxxxxx",
    "app_secret": "xxxxxxxxxxxxxxxx",
    "domain": "feishu",
    "owner_open_id": "ou_xxxxxxxxxxxxx",
    "allowed_senders": [],
    "blocked_senders": [],
    "group_policy": "open",
    "allow_unmentioned": false
  },
  "nodes": {
    "host-3": { "addr": "10.0.0.3:7701", "token": "replace-me", "dial_timeout": "10s", "level": "restricted" }
  },
  "gateway": {
    "default_project": "steve",
    "level": "restricted",
    "planner": "claude",
    "capabilities": ["basic"],
    "read_model_addr": "127.0.0.1:7710",
    "prompt_timeout": "10m",
    "state_path": "~/.steve/state.json",
    "task_max_turns": 24,
    "task_max_elapsed": "45m",
    "offline_reminder_after": "15m"
  }
}
