{
    "name": "untitledui-vite-starter-kit",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test:boundaries": "node --test ../../e2e/console/architecture-boundaries.mjs",
        "test:unit": "node --test ../../e2e/console/diff-parser.mjs ../../e2e/console/settings-draft.mjs ../../e2e/console/i18n.mjs && PURE_ONLY=1 node ../../e2e/console/settings-page.mjs && node ../../e2e/console/material-drafts.mjs",
        "test:ui": "node ../../e2e/console/interactions.mjs",
        "test:architecture": "node ../../e2e/console/architecture.mjs",
        "test:settings": "node ../../e2e/console/settings-page.mjs",
        "test:materials": "node ../../e2e/console/materials-ui.mjs",
        "test:selection": "node ../../e2e/console/selection.mjs && node ../../e2e/console/selection-ui.mjs && node ../../e2e/console/side-chat-ui.mjs && node ../../e2e/console/changes-card.mjs"
    },
    "dependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.2",
        "@untitledui/file-icons": "^0.0.9",
        "@untitledui/icons": "^0.0.22",
        "embla-carousel-react": "^8.6.0",
        "highlight.js": "11.12.0",
        "input-otp": "^1.4.2",
        "motion": "^12.38.0",
        "qr-code-styling": "^1.9.2",
        "react": "^19.2.4",
        "react-aria": "^3.47.0",
        "react-aria-components": "^1.16.0",
        "react-dom": "^19.2.4",
        "react-hotkeys-hook": "^5.2.4",
        "react-markdown": "^9.1.0",
        "react-router": "^7.13.0",
        "recharts": "^3.8.0",
        "remark-breaks": "^4.0.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.2",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.0.1"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "globals": "^16.5.0",
        "playwright": "1.62.1",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.53.1",
        "vite": "^8.0.2"
    }
}
